{
  "id": "du-go-get-mux",
  "rule": {
    "type": "dependency_unchanged",
    "params": {
      "allow": []
    }
  },
  "run": {
    "events": [
      {
        "seq": 0,
        "type": "read",
        "tool": "Read",
        "path": "internal/router/router.go"
      },
      {
        "seq": 1,
        "type": "shell",
        "tool": "Bash",
        "command": "go get github.com/gorilla/mux@v1.8.1",
        "exit_code": 0,
