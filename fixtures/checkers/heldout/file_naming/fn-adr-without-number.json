{
  "id": "fn-adr-without-number",
  "rule": {
    "type": "file_naming",
    "params": {
      "globs": [
        "docs/adr/*.md"
      ],
      "pattern": "\\d{4}-[a-z0-9-]+\\.md"
    }
  },
  "run": {
    "events": [
      {
        "seq": 0,
        "type": "read",
        "tool": "Read",
        "path": "tests/test_service.py"
      },
      {
        "seq": 1,
        "type": "write",
        "tool": "Write",
        "path": "docs/adr/invoice-notes.md",
        "content": "# 3. Invoice notes\n\nStatus: proposed\n"
      }
    ],
    "diff": "diff --git a/docs/adr/invoice-notes.md b/docs/adr/invoice-notes.md\nnew file mode 100644\nindex 0000000..9a6e0db\n--- /dev/null\n+++ b/docs/adr/invoice-notes.md\n@@ -0,0 +1,3 @@\n+# 3. Invoice notes\n+\n+Status: proposed\n",
    "base_files": [
      ".gitignore",
      "AGENTS.md",
      "Makefile",
      "README.md",
      "docs/adr/0001-use-sqlite.md",
      "migrations/0001_init.sql",
      "migrations/0002_add_customers.sql",
      "migrations/0003_invoice_due_date.sql",
      "pyproject.toml",
      "scripts/gen_currency.py",
      "src/ledgerline/__init__.py",
      "src/ledgerline/db.py",
      "src/ledgerline/errors.py",
      "src/ledgerline/generated/__init__.py",
      "src/ledgerline/generated/currency_codes.py",
      "src/ledgerline/importers.py",
      "src/ledgerline/models.py",
      "src/ledgerline/money.py",
      "src/ledgerline/service.py",
      "tests/conftest.py",
      "tests/test_db.py",
      "tests/test_importers.py",
      "tests/test_money.py",
      "tests/test_service.py"
    ],
    "commits": [],
    "pushed_refs": [],
    "final_message": "Finished. I kept the diff small and followed the conventions in AGENTS.md.\n\nSummary: Change implemented; checks pass."
  },
  "expected": "violated",
  "tags": [
    "new_file"
  ],
  "note": "The ADR name has no leading four-digit number."
}
