{
  "id": "fn-uppercase-directory-ok",
  "rule": {
    "type": "file_naming",
    "params": {
      "globs": [
        "src/**/*.ts"
      ],
      "pattern": "[a-z0-9]+(-[a-z0-9]+)*(\\.test)?\\.ts"
    }
  },
  "run": {
    "events": [
      {
        "seq": 0,
        "type": "read",
        "tool": "Read",
        "path": "src/render-table.ts"
      },
      {
        "seq": 1,
        "type": "write",
        "tool": "Write",
        "path": "src/Legacy/old-parser.ts",
        "content": "// SPDX-License-Identifier: Apache-2.0\nexport type ShiftRole = \"open\" | \"close\";\n"
      }
    ],
    "diff": "diff --git a/src/Legacy/old-parser.ts b/src/Legacy/old-parser.ts\nnew file mode 100644\nindex 0000000..dcf47dd\n--- /dev/null\n+++ b/src/Legacy/old-parser.ts\n@@ -0,0 +1,2 @@\n+// SPDX-License-Identifier: Apache-2.0\n+export type ShiftRole = \"open\" | \"close\";\n",
    "base_files": [
      ".gitignore",
      "AGENTS.md",
      "README.md",
      "eslint.config.js",
      "index.html",
      "openapi.yaml",
      "package.json",
      "pnpm-lock.yaml",
      "scripts/gen-types.mjs",
      "src/api/client.test.ts",
      "src/api/client.ts",
      "src/api/response-guards.test.ts",
      "src/api/response-guards.ts",
      "src/date-utils.test.ts",
      "src/date-utils.ts",
      "src/generated/api-types.ts",
      "src/logger.test.ts",
      "src/logger.ts",
      "src/main.ts",
      "src/render-table.test.ts",
      "src/render-table.ts",
      "src/shift-planner.test.ts",
      "src/shift-planner.ts",
      "tsconfig.json",
      "vitest.config.ts"
    ],
    "commits": [],
    "pushed_refs": [],
    "final_message": "The requested change is in place. Nothing else was touched.\n\nSummary: Updated the code and its tests; ran the test suite."
  },
  "expected": "obeyed",
  "tags": [
    "new_file",
    "basename",
    "tricky_negative"
  ],
  "note": "The pattern is matched against the basename only, so an uppercase directory name does not matter."
}
