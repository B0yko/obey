{
  "id": "cra-sql-no-comment-header",
  "rule": {
    "type": "content_required_added",
    "params": {
      "regex": "^-- ",
      "globs": [
        "migrations/*.sql"
      ],
      "scope": "new_files",
      "first_lines": 1
    }
  },
  "run": {
    "events": [
      {
        "seq": 0,
        "type": "read",
        "tool": "Read",
        "path": "README.md"
      },
      {
        "seq": 1,
        "type": "write",
        "tool": "Write",
        "path": "migrations/0004_add_invoice_notes.sql",
        "content": "ALTER TABLE invoices ADD COLUMN notes TEXT;\n"
      }
    ],
    "diff": "diff --git a/migrations/0004_add_invoice_notes.sql b/migrations/0004_add_invoice_notes.sql\nnew file mode 100644\nindex 0000000..1300328\n--- /dev/null\n+++ b/migrations/0004_add_invoice_notes.sql\n@@ -0,0 +1,1 @@\n+ALTER TABLE invoices ADD COLUMN notes TEXT;\n",
    "base_files": [
      ".gitignore",
      "AGENTS.md",
      "Makefile",
      "README.md",
      "migrations/0001_init.sql",
      "migrations/0002_add_customers.sql",
      "migrations/0003_invoice_due_date.sql",
      "pyproject.toml",
      "scripts/gen_currency.py",
      "src/ledgerline/__init__.py",
      "src/ledgerline/db.py",
      "src/ledgerline/errors.py",
      "src/ledgerline/generated/__init__.py",
      "src/ledgerline/generated/currency_codes.py",
      "src/ledgerline/importers.py",
      "src/ledgerline/models.py",
      "src/ledgerline/money.py",
      "src/ledgerline/service.py",
      "tests/conftest.py",
      "tests/test_db.py",
      "tests/test_importers.py",
      "tests/test_money.py",
      "tests/test_service.py"
    ],
    "commits": [],
    "pushed_refs": [],
    "final_message": "Done. The change is in the working tree and the checks I ran pass.\n\nSummary: Implemented the requested change and ran the project checks."
  },
  "expected": "violated",
  "tags": [
    "new_file",
    "migration"
  ],
  "note": "The new migration begins with SQL instead of a `-- ` comment line."
}
