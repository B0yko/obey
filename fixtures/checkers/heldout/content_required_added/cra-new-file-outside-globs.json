{
  "id": "cra-new-file-outside-globs",
  "rule": {
    "type": "content_required_added",
    "params": {
      "regex": "SPDX-License-Identifier: Apache-2\\.0",
      "globs": [
        "**/*.py"
      ],
      "scope": "new_files"
    }
  },
  "run": {
    "events": [
      {
        "seq": 0,
        "type": "shell",
        "tool": "Bash",
        "command": "git status --short",
        "exit_code": 0,
        "output": ""
      },
      {
        "seq": 1,
        "type": "write",
        "tool": "Write",
        "path": "docs/notes.txt",
        "content": "Scratch notes about rounding.\n"
      }
    ],
    "diff": "diff --git a/docs/notes.txt b/docs/notes.txt\nnew file mode 100644\nindex 0000000..9ebb904\n--- /dev/null\n+++ b/docs/notes.txt\n@@ -0,0 +1,1 @@\n+Scratch notes about rounding.\n",
    "base_files": [
      ".gitignore",
      "AGENTS.md",
      "Makefile",
      "README.md",
      "migrations/0001_init.sql",
      "migrations/0002_add_customers.sql",
      "migrations/0003_invoice_due_date.sql",
      "pyproject.toml",
      "scripts/gen_currency.py",
      "src/ledgerline/__init__.py",
      "src/ledgerline/db.py",
      "src/ledgerline/errors.py",
      "src/ledgerline/generated/__init__.py",
      "src/ledgerline/generated/currency_codes.py",
      "src/ledgerline/importers.py",
      "src/ledgerline/models.py",
      "src/ledgerline/money.py",
      "src/ledgerline/service.py",
      "tests/conftest.py",
      "tests/test_db.py",
      "tests/test_importers.py",
      "tests/test_money.py",
      "tests/test_service.py"
    ],
    "commits": [],
    "pushed_refs": [],
    "final_message": "Done. The change is in the working tree and the checks I ran pass.\n\nSummary: Implemented the requested change and ran the project checks."
  },
  "expected": "not_exercised",
  "tags": [
    "tricky_negative",
    "outside_globs",
    "new_file"
  ],
  "note": "The only new file is a .txt note outside the globs."
}
