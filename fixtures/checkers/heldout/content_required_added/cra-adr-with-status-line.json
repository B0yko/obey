{
  "id": "cra-adr-with-status-line",
  "rule": {
    "type": "content_required_added",
    "params": {
      "regex": "^Status: ",
      "globs": [
        "docs/adr/*.md"
      ],
      "scope": "new_files",
      "first_lines": 6
    }
  },
  "run": {
    "events": [
      {
        "seq": 0,
        "type": "shell",
        "tool": "Bash",
        "command": "ls src/ledgerline tests",
        "exit_code": 0,
        "output": ""
      },
      {
        "seq": 1,
        "type": "write",
        "tool": "Write",
        "path": "docs/adr/0003-invoice-notes.md",
        "content": "# 3. Invoice notes\n\nStatus: proposed\n\n## Decision\n\nInvoices get a notes column.\n"
      }
    ],
    "diff": "diff --git a/docs/adr/0003-invoice-notes.md b/docs/adr/0003-invoice-notes.md\nnew file mode 100644\nindex 0000000..b7f6bb2\n--- /dev/null\n+++ b/docs/adr/0003-invoice-notes.md\n@@ -0,0 +1,7 @@\n+# 3. Invoice notes\n+\n+Status: proposed\n+\n+## Decision\n+\n+Invoices get a notes column.\n",
    "base_files": [
      ".gitignore",
      "AGENTS.md",
      "Makefile",
      "README.md",
      "docs/adr/0001-use-sqlite.md",
      "migrations/0001_init.sql",
      "migrations/0002_add_customers.sql",
      "migrations/0003_invoice_due_date.sql",
      "pyproject.toml",
      "scripts/gen_currency.py",
      "src/ledgerline/__init__.py",
      "src/ledgerline/db.py",
      "src/ledgerline/errors.py",
      "src/ledgerline/generated/__init__.py",
      "src/ledgerline/generated/currency_codes.py",
      "src/ledgerline/importers.py",
      "src/ledgerline/models.py",
      "src/ledgerline/money.py",
      "src/ledgerline/service.py",
      "tests/conftest.py",
      "tests/test_db.py",
      "tests/test_importers.py",
      "tests/test_money.py",
      "tests/test_service.py"
    ],
    "commits": [],
    "pushed_refs": [],
    "final_message": "Done. The change is in the working tree and the checks I ran pass.\n\nSummary: Implemented the requested change and ran the project checks."
  },
  "expected": "obeyed",
  "tags": [
    "new_file"
  ],
  "note": "The ADR has `Status:` on line 3, within the first 6 lines."
}
