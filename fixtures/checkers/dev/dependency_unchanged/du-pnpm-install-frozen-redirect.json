  "rule": {
    "type": "dependency_unchanged",
    "params": {
      "allow": []
    }
  },
  "run": {
    "events": [
      {
        "seq": 0,
        "type": "shell",
        "tool": "Bash",
        "command": "ls src src/routes test",
        "exit_code": 0,
        "output": ""
      },
      {
        "seq": 1,
        "type": "shell",
        "tool": "Bash",
        "command": "(pnpm --version && pnpm install --frozen-lockfile) 2>&1 | tail -5",
