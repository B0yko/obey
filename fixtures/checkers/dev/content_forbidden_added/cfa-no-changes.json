{
  "id": "cfa-no-changes",
  "rule": {
    "type": "content_forbidden_added",
    "params": {
      "regex": "\\bprint\\(",
      "globs": [
        "src/**/*.py"
      ]
    }
  },
  "run": {
    "events": [
      {
        "seq": 0,
        "type": "read",
        "tool": "Read",
        "path": "tests/test_service.py"
      },
      {
        "seq": 1,
        "type": "shell",
        "tool": "Bash",
        "command": "git status --short",
        "exit_code": 0,
        "output": ""
      },
      {
        "seq": 2,
        "type": "message",
        "text": "There is nothing to change."
      }
    ],
    "diff": "",
    "base_files": [
      ".gitignore",
      "AGENTS.md",
      "Makefile",
      "README.md",
      "migrations/0001_init.sql",
      "migrations/0002_add_customers.sql",
