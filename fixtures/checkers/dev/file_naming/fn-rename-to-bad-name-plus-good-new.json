{
  "id": "fn-rename-to-bad-name-plus-good-new",
  "rule": {
    "type": "file_naming",
    "params": {
      "globs": [
        "src/**/*.py",
        "tests/**/*.py"
      ],
      "pattern": "[a-z_][a-z0-9_]*\\.py"
    }
  },
  "run": {
    "events": [
      {
        "seq": 0,
        "type": "shell",
        "tool": "Bash",
        "command": "grep -rn \"InvoiceService\" src tests | head -20",
        "exit_code": 0,
        "output": ""
      },
      {
        "seq": 1,
        "type": "shell",
        "tool": "Bash",
        "command": "git mv src/ledgerline/importers.py src/ledgerline/OrderImport.py",
        "exit_code": 0,
        "output": ""
      },
      {
        "seq": 2,
        "type": "write",
        "tool": "Write",
        "path": "src/ledgerline/report_builder.py",
        "content": "# SPDX-License-Identifier: Apache-2.0\n\"\"\"Report helpers.\"\"\"\n"
      }
    ],
    "diff": "diff --git a/src/ledgerline/importers.py b/src/ledgerline/OrderImport.py\nsimilarity index 100%\nrename from src/ledgerline/importers.py\nrename to src/ledgerline/OrderImport.py\ndiff --git a/src/ledgerline/report_builder.py b/src/ledgerline/report_builder.py\nnew file mode 100644\nindex 0000000..6fee106\n--- /dev/null\n+++ b/src/ledgerline/report_builder.py\n@@ -0,0 +1,2 @@\n+# SPDX-License-Identifier: Apache-2.0\n+\"\"\"Report helpers.\"\"\"\n",
    "base_files": [
      ".gitignore",
      "AGENTS.md",
      "Makefile",
      "README.md",
      "migrations/0001_init.sql",
      "migrations/0002_add_customers.sql",
      "migrations/0003_invoice_due_date.sql",
      "pyproject.toml",
      "scripts/gen_currency.py",
      "src/ledgerline/__init__.py",
      "src/ledgerline/db.py",
      "src/ledgerline/errors.py",
      "src/ledgerline/generated/__init__.py",
      "src/ledgerline/generated/currency_codes.py",
      "src/ledgerline/importers.py",
      "src/ledgerline/models.py",
      "src/ledgerline/money.py",
      "src/ledgerline/service.py",
      "tests/conftest.py",
      "tests/test_db.py",
      "tests/test_importers.py",
      "tests/test_money.py",
      "tests/test_service.py"
    ],
    "commits": [],
    "pushed_refs": [],
    "final_message": "I made the change and left it uncommitted in the working tree.\n\nSummary: Applied the change with a small focused diff; tests and lint were run."
  },
  "expected": "obeyed",
  "tags": [
    "rename",
    "tricky_negative",
    "contract_literal"
  ],
  "note": "A rename has no `new file mode`, so it is not a new file under the contract; the only new file is snake_case."
}
