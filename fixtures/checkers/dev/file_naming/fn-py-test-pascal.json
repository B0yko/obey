{
  "id": "fn-py-test-pascal",
  "rule": {
    "type": "file_naming",
    "params": {
      "globs": [
        "tests/**/*.py"
      ],
      "pattern": "(test_[a-z0-9_]+|conftest|__init__)\\.py"
    }
  },
  "run": {
    "events": [
      {
        "seq": 0,
        "type": "shell",
        "tool": "Bash",
        "command": "cat Makefile",
        "exit_code": 0,
        "output": ".PHONY: test lint typecheck gen\n\ntest:\n\tuv run pytest -q\n"
      },
      {
        "seq": 1,
        "type": "write",
        "tool": "Write",
        "path": "tests/TestRounding.py",
        "content": "# SPDX-License-Identifier: Apache-2.0\n"
      }
    ],
    "diff": "diff --git a/tests/TestRounding.py b/tests/TestRounding.py\nnew file mode 100644\nindex 0000000..d972638\n--- /dev/null\n+++ b/tests/TestRounding.py\n@@ -0,0 +1,1 @@\n+# SPDX-License-Identifier: Apache-2.0\n",
    "base_files": [
      ".gitignore",
      "AGENTS.md",
      "Makefile",
      "README.md",
      "migrations/0001_init.sql",
      "migrations/0002_add_customers.sql",
      "migrations/0003_invoice_due_date.sql",
      "pyproject.toml",
      "scripts/gen_currency.py",
      "src/ledgerline/__init__.py",
      "src/ledgerline/db.py",
      "src/ledgerline/errors.py",
      "src/ledgerline/generated/__init__.py",
      "src/ledgerline/generated/currency_codes.py",
      "src/ledgerline/importers.py",
      "src/ledgerline/models.py",
      "src/ledgerline/money.py",
      "src/ledgerline/service.py",
      "tests/conftest.py",
      "tests/test_db.py",
      "tests/test_importers.py",
      "tests/test_money.py",
      "tests/test_service.py"
    ],
    "commits": [],
    "pushed_refs": [],
    "final_message": "Finished. I kept the diff small and followed the conventions in AGENTS.md.\n\nSummary: Change implemented; checks pass."
  },
  "expected": "violated",
  "tags": [
    "new_file",
    "case"
  ],
  "note": "TestRounding.py does not match test_<module>.py."
}
