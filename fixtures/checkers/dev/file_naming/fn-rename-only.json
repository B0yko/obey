{
  "id": "fn-rename-only",
  "rule": {
    "type": "file_naming",
    "params": {
      "globs": [
        "src/**/*.py",
        "tests/**/*.py"
      ],
      "pattern": "[a-z_][a-z0-9_]*\\.py"
    }
  },
  "run": {
    "events": [
      {
        "seq": 0,
        "type": "shell",
        "tool": "Bash",
        "command": "grep -rn \"InvoiceService\" src tests | head -20",
        "exit_code": 0,
        "output": ""
      },
      {
        "seq": 1,
        "type": "shell",
        "tool": "Bash",
        "command": "git mv src/ledgerline/importers.py src/ledgerline/OrderImport.py",
        "exit_code": 0,
        "output": ""
      }
    ],
    "diff": "diff --git a/src/ledgerline/importers.py b/src/ledgerline/OrderImport.py\nsimilarity index 100%\nrename from src/ledgerline/importers.py\nrename to src/ledgerline/OrderImport.py\n",
    "base_files": [
      ".gitignore",
      "AGENTS.md",
      "Makefile",
      "README.md",
      "migrations/0001_init.sql",
      "migrations/0002_add_customers.sql",
      "migrations/0003_invoice_due_date.sql",
      "pyproject.toml",
      "scripts/gen_currency.py",
      "src/ledgerline/__init__.py",
      "src/ledgerline/db.py",
      "src/ledgerline/errors.py",
      "src/ledgerline/generated/__init__.py",
      "src/ledgerline/generated/currency_codes.py",
      "src/ledgerline/importers.py",
      "src/ledgerline/models.py",
      "src/ledgerline/money.py",
      "src/ledgerline/service.py",
      "tests/conftest.py",
      "tests/test_db.py",
      "tests/test_importers.py",
      "tests/test_money.py",
      "tests/test_service.py"
    ],
    "commits": [],
    "pushed_refs": [],
    "final_message": "The requested change is in place. Nothing else was touched.\n\nSummary: Updated the code and its tests; ran the test suite."
  },
  "expected": "not_exercised",
  "tags": [
    "rename",
    "tricky_negative",
    "contract_literal"
  ],
  "note": "The contract defines new files by `new file mode`, so a pure rename creates no new file and the rule is not exercised."
}
