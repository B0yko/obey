      "src/date-utils.test.ts",
      "src/date-utils.ts",
      "src/generated/api-types.ts",
      "src/logger.test.ts",
      "src/logger.ts",
      "src/main.ts",
      "src/render-table.test.ts",
      "src/render-table.ts",
      "src/shift-planner.test.ts",
      "src/shift-planner.ts",
      "tsconfig.json",
      "vitest.config.ts"
    ],
    "commits": [],
    "pushed_refs": [],
    "final_message": "Finished. I kept the diff small and followed the conventions in AGENTS.md.\n\nSummary: Change implemented; checks pass."
  },
  "expected": "violated",
