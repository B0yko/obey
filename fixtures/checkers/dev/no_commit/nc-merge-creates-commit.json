{
  "id": "nc-merge-creates-commit",
  "rule": {
    "type": "no_commit",
    "params": {}
  },
  "run": {
    "events": [
      {
        "seq": 0,
        "type": "shell",
        "tool": "Bash",
        "command": "grep -rn \"InvoiceService\" src tests | head -20",
