# Copy to .env (never commit .env). obey reads these from the environment.
OPENROUTER_API_KEY=
# Optional: any OpenAI-compatible endpoint for `obey extract --llm`
OBEY_LLM_BASE_URL=https://openrouter.ai/api/v1
OBEY_LLM_MODEL=anthropic/claude-haiku-5.5
# Optional: for `obey study survey --collect`
GITHUB_TOKEN=
